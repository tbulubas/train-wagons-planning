    </mxCell>
    <mxCell id="bandLanes" value="LANES — FIFO buffer and capacity" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#fafafa;strokeColor=#bbbbbb;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="80" y="540" width="1560" height="340" as="geometry"/>
    </mxCell>
    <mxCell id="bandCrit" value="CRITERIA — minimised lexicographically, order is a parameter" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#fcf8fd;strokeColor=#bbbbbb;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
      <mxGeometry x="80" y="910" width="1560" height="140" as="geometry"/>
    </mxCell>

    <!-- ====================================================================== -->
