    <mxCell id="e6" value="(10)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="D" target="a">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e7" value="(11)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="a" target="h">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e8" value="(11)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z" target="h">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e9" value="(12)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="h" target="cap">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e10" value="(12) own wagons of T_p" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.2;exitY=1;entryX=0.75;entryY=1;" edge="1" parent="1" source="z" target="cap">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1112" y="700"/>
          <mxPoint x="615" y="700"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e11" value="(12) M · v(ℓ)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;entryX=0.25;entryY=1;" edge="1" parent="1" source="v" target="cap">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="485" y="775"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e12" value="sum over lanes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="cap" target="agg">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e13" value="(5)–(7)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z" target="rho">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e14" value="(5)–(7) FIFO" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.9;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="r" target="rho">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1294" y="300"/>
          <mxPoint x="1510" y="300"/>
        </Array>
      </mxGeometry>
    </mxCell>
    <mxCell id="e15" value="(16)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="r" target="F">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e16" value="(13)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="z" target="v">
      <mxGeometry relative="1" as="geometry"/>
    </mxCell>
    <mxCell id="e17" value="(13)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#555555;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.85;entryX=0;entryY=0.5;" edge="1" parent="1" source="z" target="n">
      <mxGeometry relative="1" as="geometry">
        <Array as="points">
          <mxPoint x="1350" y="650"/>
          <mxPoint x="1350" y="750"/>
        </Array>
      </mxGeometry>
