    <!-- ====================================================================== -->
    <mxCell id="agg" value="&lt;b&gt;(15)&lt;/b&gt; aggregated capacity&lt;br&gt;Σ over lanes of (12):&lt;br&gt;own + pre-loaded ≤ M · Σ v" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="100" y="590" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="cap" value="&lt;b&gt;(12)&lt;/b&gt; lane capacity&lt;br&gt;right before T_p leaves:&lt;br&gt;Σ w · z + Σ w · h ≤ M · v(ℓ)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="420" y="590" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="h" value="&lt;b&gt;h(i, p, ℓ)&lt;/b&gt; ∈ [0, 1]&lt;br&gt;= a(i, p) · z(i, ℓ)&lt;br&gt;largest block of the model" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="740" y="590" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="z" value="&lt;b&gt;z(i, ℓ)&lt;/b&gt; ∈ {0, 1}&lt;br&gt;wagon i goes to lane ℓ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1060" y="590" width="260" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="rho" value="&lt;b&gt;ρ(ℓ, i)&lt;/b&gt; ∈ [0, R]&lt;br&gt;highest run among the&lt;br&gt;wagons 1 … i in lane ℓ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1380" y="590" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="v" value="&lt;b&gt;v(ℓ)&lt;/b&gt; ∈ {0, 1}&lt;br&gt;lane ℓ is used" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1060" y="740" width="260" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="n" value="&lt;b&gt;n(ℓ) = Σ_i z(i, ℓ)&lt;/b&gt;&lt;br&gt;wagons in lane ℓ" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
      <mxGeometry x="1380" y="720" width="260" height="60" as="geometry"/>
    </mxCell>
    <mxCell id="sym" value="&lt;b&gt;(14)&lt;/b&gt; n(ℓ+1) ≤ n(ℓ)&lt;br&gt;busiest lane first (priority)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1380" y="805" width="260" height="60" as="geometry"/>
    </mxCell>

