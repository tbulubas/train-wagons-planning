    <!-- ====================================================================== -->
    <mxCell id="u" value="&lt;b&gt;u(r)&lt;/b&gt; ∈ {0, 1}&lt;br&gt;run slot r is used" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="100" y="150" width="260" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="y" value="&lt;b&gt;y(r, g)&lt;/b&gt; ∈ {0, 1}&lt;br&gt;run r loads goods type g" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
