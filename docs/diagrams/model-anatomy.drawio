      <mxGeometry x="80" y="100" width="1560" height="160" as="geometry"/>
    </mxCell>
    <mxCell id="bandDep" value="DEPARTURES — trains leave one after another" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#fafafa;strokeColor=#bbbbbb;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
