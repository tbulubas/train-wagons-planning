    </mxCell>

    <!-- ====================================================================== -->
    <!-- CRITERIA -->
    <!-- ====================================================================== -->
    <mxCell id="c1" value="&lt;b&gt;changes&lt;/b&gt;&lt;br&gt;C = Σ_r u(r) − 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="100" y="960" width="260" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="c2" value="&lt;b&gt;lanes&lt;/b&gt;&lt;br&gt;L = Σ_ℓ v(ℓ)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="420" y="960" width="260" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="c3" value="&lt;b&gt;waiting&lt;/b&gt;&lt;br&gt;Σ_p n_p · Σ_i a(i, p) + const" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="740" y="960" width="260" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="c4" value="&lt;b&gt;peak&lt;/b&gt;&lt;br&gt;P ≥ n_p + Σ_i a(i, p)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1060" y="960" width="260" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="c5" value="&lt;b&gt;priority&lt;/b&gt;&lt;br&gt;Q = Σ c(ℓ) · z(i, ℓ)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1380" y="960" width="260" height="70" as="geometry"/>
    </mxCell>

    <!-- ====================================================================== -->
    <!-- CONSTRAINT LIST -->
    <!-- ====================================================================== -->
    <mxCell id="list" value="&lt;b&gt;Constraints&lt;/b&gt;&lt;br&gt;&lt;br&gt;(1) every wagon: one run, one lane&lt;br&gt;(2) a wagon&#x27;s run carries its goods type&lt;br&gt;(3) one goods type per used run; used runs first, none empty&lt;br&gt;(4) consecutive runs have different goods&lt;br&gt;(5)–(7) FIFO: along the keys, the runs of the wagons&lt;br&gt;in a lane do not decrease (ρ = highest run so far)&lt;br&gt;(8) T_p leaves in the run of its last wagon&lt;br&gt;(9) … and not before T_(p−1)&lt;br&gt;(10) a wagon of a later train in a run before D(p)&lt;br&gt;is in the buffer when T_p leaves&lt;br&gt;(11) h = a · z, exact (Σ_ℓ h = a, h ≤ z)&lt;br&gt;(12) lane capacity right before every departure&lt;br&gt;(13) lane used ⇔ it holds wagons&lt;br&gt;(14) lanes ordered by their number of wagons&lt;br&gt;(15) sum of (12) over all lanes — implied, stronger LP&lt;br&gt;(16) optional spread S: F(k) ≤ r(i) ≤ F(k) + S,&lt;br&gt;a train within S + 1 consecutive runs" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;align=center;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
      <mxGeometry x="1680" y="100" width="460" height="485" as="geometry"/>
    </mxCell>

    <!-- ====================================================================== -->
    <!-- THREE FACTS AND SIZE -->
    <!-- ====================================================================== -->
    <mxCell id="facts" value="&lt;b&gt;Three facts&lt;/b&gt; (proved in mip-model.md)&lt;br&gt;&lt;br&gt;&lt;b&gt;1&lt;/b&gt; Inside a run the wagons are loaded in extraction order (by key).&lt;br&gt;&lt;br&gt;&lt;b&gt;2&lt;/b&gt; A FIFO lane never blocks ⇔ its run numbers do not decrease along the keys.&lt;br&gt;&lt;br&gt;&lt;b&gt;3&lt;/b&gt; Lane weight only grows between departures: check capacity right before each one.&lt;br&gt;&lt;br&gt;So the model only chooses a run and a lane for every wagon." style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
      <mxGeometry x="1680" y="600" width="460" height="270" as="geometry"/>
    </mxCell>
    <mxCell id="size" value="&lt;b&gt;Size&lt;/b&gt; for 300 wagons, 26 lanes, 20 runs:&lt;br&gt;x 6 000 · z 7 800 · a ≈ 4 350 binaries&lt;br&gt;h ≈ 113 000 continuous — h dominates" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#f5f5f5;strokeColor=#666666;fontSize=12;align=center;verticalAlign=middle;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;" vertex="1" parent="1">
      <mxGeometry x="1680" y="910" width="460" height="140" as="geometry"/>
    </mxCell>
    <mxCell id="copy" value="© 2026 Taras Bulubas. All rights reserved." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=10;fontColor=#999999;" vertex="1" parent="1">
      <mxGeometry x="80" y="1055" width="600" height="20" as="geometry"/>
    </mxCell>
  </root>
</mxGraphModel>
