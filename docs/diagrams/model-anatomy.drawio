    </mxCell>
    <mxCell id="x" value="&lt;b&gt;x(i, r)&lt;/b&gt; ∈ {0, 1}&lt;br&gt;wagon i is loaded in run r" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="740" y="150" width="260" height="70" as="geometry"/>
    </mxCell>
    <mxCell id="r" value="&lt;b&gt;r(i) = Σ_r r · x(i, r)&lt;/b&gt;&lt;br&gt;run number of wagon i" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;dashed=1;" vertex="1" parent="1">
