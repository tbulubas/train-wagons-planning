    <!-- ====================================================================== -->
    <mxCell id="a" value="&lt;b&gt;a(i, p)&lt;/b&gt; ∈ {0, 1}, p &amp;lt; k(i)&lt;br&gt;wagon i is in the buffer&lt;br&gt;before T_p leaves (pre-loaded)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="740" y="370" width="260" height="80" as="geometry"/>
    </mxCell>
    <mxCell id="D" value="&lt;b&gt;D(p)&lt;/b&gt; ∈ [1, R]&lt;br&gt;run during which T_p leaves" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
      <mxGeometry x="1060" y="370" width="260" height="70" as="geometry"/>
