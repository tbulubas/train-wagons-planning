    <mxCell id="title" value="Train Wagons Planning — Anatomy of the MILP" style="text;html=1;whiteSpace=wrap;align=center;verticalAlign=top;fontSize=22;fontColor=#333333;fontStyle=1;" vertex="1" parent="1">
      <mxGeometry x="80" y="20" width="1560" height="36" as="geometry"/>
