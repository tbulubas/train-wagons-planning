    <mxCell id="bandSolve" value="Lexicographic solve" style="rounded=1;whiteSpace=wrap;html=1;arcSize=2;fillColor=#fafafa;strokeColor=#bbbbbb;dashed=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#666666;" vertex="1" parent="1">
